// The backend is imported in place: core, db and the */types packages, never a module body.
replace app => ../backend

// replace directives are not inherited from a dependency's go.mod, so every one the backend
// declares is repeated here, rebased onto this folder. Keep the two lists in step.
replace github.com/gocql/gocql v1.6.0 => ../backend/genix-orm/thirdparty/gocql

replace github.com/ivanjoz/facturago => ../backend/facturago

replace github.com/ivanjoz/fareward/go => ../fareward/go

replace google.golang.org/protobuf => ../backend/thirdparty/protobuf

replace github.com/ivanjoz/genix-orm => ../backend/genix-orm

replace github.com/ivanjoz/genix-orm/db => ../backend/genix-orm/db

replace github.com/ivanjoz/genix-orm/search/daemon => ../backend/genix-orm/search/daemon

replace github.com/ivanjoz/genix-orm/search/genixs3 => ../backend/genix-orm/search/genixs3

replace github.com/ivanjoz/genix-search/genix-s3 => ../../genix-search/genix-s3

replace github.com/ivanjoz/genix-orm/utils => ../backend/genix-orm/utils

replace github.com/ivanjoz/genix-orm/dataframe => ../backend/genix-orm/dataframe

replace github.com/bytedance/sonic => github.com/ivanjoz/sonic v1.15.6-0.20261028001949-a834f9c878ac
