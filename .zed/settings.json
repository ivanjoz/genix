{
	"file_scan_exclusions": [
		"**/frontend_deprecated/**",
		"**/node_modules/**",
		"**/dist/**",
		"**/build/**",
		"**/target/**",
		"**/.git/**",
		"**/.vscode/**",
		"./docs/**",
		"**/store_deprecated/**",
		"**/.svelte-kit/**"
	],
	"languages": {
    "CSS": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    },
    "HTML": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    },
    "JavaScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    },
    "Svelte": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    },
    "TSX": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    },
    "TypeScript": {
      "language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server","...", "!tailwindcss-language-server"]
    }
  }
}
