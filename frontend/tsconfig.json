{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		// Storefront files are checked here too, and their package.json (webpage/) points these
		// layers at "../" targets, which TypeScript rejects. Same targets as the "imports" here.
		"paths": {
			"#components/*": ["./packages/genix-ui/*"],
			"#core/*": ["./core/*"],
			"#libs/*": ["./libs/*"],
			"#services/*": ["./services/*"],
			"#domain/*": ["./domain-components/*"]
		}
	},
	"include": [
		".svelte-kit/types/**/$types.d.ts",
		"app.d.ts",
		"globals.d.ts",
		"routes/**/*",
		"core/**/*",
		"libs/**/*",
		"services/**/*",
		"domain-components/**/*"
	],
	// Bun test files (`bun:test`) are run by `bun test`, not svelte-check; exclude
	// them so the type checker doesn't choke on the missing `bun:test` module.
	"exclude": ["**/*.test.ts"]
}
