{
	"name": "genix-frontend",
	"private": true,
	"version": "2.0.0",
	"type": "module",
	"workspaces": [
		"./webpage",
		"./packages/*"
	],
	"imports": {
		"#components/*": "./packages/genix-ui/*",
		"#core/*": "./core/*",
		"#libs/*": "./libs/*",
		"#services/*": "./services/*",
		"#domain/*": "./domain-components/*",
		"#ecommerce/*": "./webpage/*",
		"#routes/*": "./routes/*"
	},
	"scripts": {
		"dev": "bun scripts/dev-all.js",
		"dev:main": "vite dev --port 3570",
		"dev:main:force": "vite dev --force --port 3570",
		"dev:store": "cd ecommerce && bun run dev",
		"serve": "bun run serve:build",
		"serve:build": "bun x serve ./build -l 3000",
		"prepare": "svelte-kit sync || echo ''",
		"build": "bun scripts/build-all.js",
		"build:main": "vite build",
		"build:store": "cd webpage && bun run build",
		"publish": "bun run build && bun postbuild.js --publish",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"package:ui": "bun run --filter @genix/ui package",
		"prebuild:store": "bun scripts/thumbhash-prebuild.js"
	},
	"devDependencies": {
		"@iconify-json/emojione": "^1.2.3",
		"@iconify-json/fa": "^1.2.2",
		"@iconify-json/flat-color-icons": "^1.2.3",
		"@iconify-json/mdi": "^1.2.3",
		"@iconify/tailwind4": "^1.2.3",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.1.13",
		"@types/mime-types": "^3.0.1",
		"@types/node": "^24.10.0",
		"@unocss/core": "^66.7.0",
		"@unocss/preset-wind4": "^66.7.0",
		"http-proxy": "^1.18.1",
		"http-proxy-middleware": "^3.0.5",
		"sharp": "^0.34.3",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-infinitable": "^0.0.14",
		"tailwindcss": "^4.1.13",
		"typescript": "^6.0.3",
		"vite": "^8.3.2"
	},
	"dependencies": {
		"@genix/ui": "workspace:*",
		"@humanspeak/svelte-virtual-list": "^0.3.5",
		"@ivanjoz/public-business-data": "github:ivanjoz/public-business-data#main",
		"billboard.js": "^3.14.3",
		"date-fns": "^4.1.0",
		"dexie": "^4.2.0",
		"dompurify": "^3.4.2",
		"embla-carousel-svelte": "^8.6.0",
		"esbuild": "^0.25.12",
		"htmlparser2": "^12.0.0",
		"leafer-ui": "^2.0.3",
		"marked": "^18.0.9",
		"mime-types": "^3.0.1",
		"modern-screenshot": "^4.7.0",
		"normalize-html-whitespace": "^1.0.0",
		"roosterjs": "^9.41.0",
		"svelte-awesome-color-picker": "^4.1.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"thumbhash": "^0.1.1"
	}
}
