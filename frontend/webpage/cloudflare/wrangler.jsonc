{
  // Un solo Worker sirve todas las tiendas, seleccionando el tenant por hostname.
  "name": "genix-storefront",
  "main": "serve-worker.js",
  "compatibility_date": "2026-06-10",
  // El HTML publicado vive en R2 bajo websites-html/<hostname>/. En el deploy real el
  // bucket lo inyecta el Go (CLOUDFLARE_BUCKET); este nombre solo aplica a `wrangler dev`.
  "r2_buckets": [{ "binding": "SITE_HTML", "bucket_name": "genix-files" }],
  "observability": {
    "enabled": true
  }
}
